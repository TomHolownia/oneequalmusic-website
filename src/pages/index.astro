---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sections from '../components/Sections.astro';
const page = (await getEntry('pages', 'home'))!;
---
<Base title={page.data.title} description={page.data.description} home>
  <Sections sections={page.data.sections} />
</Base>
