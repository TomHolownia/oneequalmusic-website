---
import Button from '../Button.astro';
import { href } from '../../lib/util';
const { b } = Astro.props;
---
<section id={b.id} class:list={{ light: b.theme === 'light' }} aria-label={b.heading}>
  <div class:list={['wrap', 'row', { rev: b.imageRight }]}>
    {b.image && <img src={href(b.image)} alt={b.imageAlt || ''} loading="lazy" style={b.imagePosition && `object-position:${b.imagePosition}`} />}
    <div class="copy">
      {b.eyebrow && <p class="eyebrow">{b.eyebrow}</p>}
      {b.heading && <h2>{b.heading}</h2>}
      {b.body && <div class="prose" set:html={b.body} />}
      {b.buttonLabel && b.buttonUrl && <div><Button label={b.buttonLabel} url={b.buttonUrl} /></div>}
    </div>
  </div>
</section>
<style>
  .row { padding-top: 72px; padding-bottom: 72px; display: flex; flex-wrap: wrap; align-items: center; gap: 40px 64px; }
  .rev { flex-direction: row-reverse; }
  img { flex: 1 1 400px; min-width: 0; width: 100%; height: 480px; object-fit: cover; }
  .copy { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  h2 { font-weight: 400; font-size: 46px; line-height: 1.05; }
  @media (max-width: 600px) { img { height: 320px; } }
</style>
