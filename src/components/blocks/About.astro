---
import { href } from '../../lib/util';
const { b } = Astro.props;
---
<section id={b.id} class="light" aria-label={b.heading}>
  <div class="wrap row">
    {b.image && <img src={href(b.image)} alt={b.imageAlt || ''} loading="lazy" />}
    <div class="copy">
      {b.eyebrow && <p class="eyebrow">{b.eyebrow}</p>}
      <h2>{b.heading}</h2>
      {b.text && <p class="prose">{b.text}</p>}
      {b.linkLabel && b.linkUrl && <a class="more" href={href(b.linkUrl)}>{b.linkLabel} →</a>}
    </div>
    {b.links?.length > 0 && (
      <nav aria-label="Our ensembles" class="links">
        {b.links.map((l: any) => <a href={href(l.url)}><span class="t">{l.title}</span><span class="s">{l.subtitle} →</span></a>)}
      </nav>
    )}
  </div>
</section>
<style>
  .row { padding-top: 88px; padding-bottom: 88px; display: flex; flex-wrap: wrap; gap: 48px 72px; }
  img { flex: 1 1 100%; width: 100%; height: 560px; object-fit: cover; object-position: 50% 20%; }
  .copy { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  h2 { font-weight: 400; font-size: 46px; line-height: 1.05; }
  .more { align-self: flex-start; color: var(--accent-dark); font-size: 15px; font-weight: 600; padding: 10px 0; }
  .links { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; }
  .links a { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 0; border-top: 1px solid #c9bba6; color: var(--bg); text-decoration: none; }
  .links a:last-child { border-bottom: 1px solid #c9bba6; }
  .links a:hover .t { color: var(--accent-dark); }
  .t { font-family: var(--serif); font-size: 28px; font-weight: 500; }
  .s { font-size: 14px; color: #5c5249; }
  @media (max-width: 600px) { .row { padding-top: 56px; padding-bottom: 56px; } img { height: 300px; } h2 { font-size: 38px; } }
</style>
