---
import Button from '../Button.astro';
import { href } from '../../lib/util';
const { b } = Astro.props;
const lines = String(b.heading || '').split('\n');
---
<section class="hero" id={b.id}>
  <div class="wrap row">
    <div class="copy">
      {b.eyebrow && <p class="eyebrow">{b.eyebrow}</p>}
      <h1>{lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
      {b.text && <p class="lead">{b.text}</p>}
      <div class="btns">{(b.buttons || []).map((x: any) => <Button {...x} />)}</div>
    </div>
    {b.image && <img src={href(b.image)} alt={b.imageAlt || ''} fetchpriority="high" />}
  </div>
</section>
<style>
  .row { padding-top: 72px; padding-bottom: 80px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px; }
  .copy { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .eyebrow { font-size: 13px; }
  h1 { font-weight: 300; font-size: clamp(56px, 8vw, 104px); line-height: 0.92; letter-spacing: 0.02em; }
  .lead { max-width: 34rem; font-size: 18px; line-height: 1.6; color: var(--text-soft); }
  .btns { padding-top: 8px; }
  img { flex: 1 1 420px; min-width: 0; width: 100%; height: 560px; object-fit: cover; object-position: 50% 35%; }
  @media (max-width: 600px) { .row { padding-top: 40px; padding-bottom: 48px; gap: 36px; } img { height: 440px; } }
</style>
